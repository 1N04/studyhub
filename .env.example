# Сгенерировать ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-me-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Ограничения на загружаемые файлы
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.xlsx,.zip,.txt